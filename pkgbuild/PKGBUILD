pkgname=codeshot
pkgver=0.1.0
pkgrel=1
pkgdesc='Turn code into a shareable image'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'wl-clipboard')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  # Absolute path: a project bin/ on PATH would otherwise shadow coreutils
  # install with this repo's own bin/install and recurse into makepkg.
  /usr/bin/install -Dm755 build/codeshot "$pkgdir/usr/bin/codeshot"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 "$startdir/codeshot.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/codeshot.svg"
  /usr/bin/install -Dm644 "$startdir/codeshot.desktop" "$pkgdir/usr/share/applications/codeshot.desktop"
}
